# Python caches and local test state
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual environments and local environment files
.venv/
venv/
env/
.env
.env.*

# Node dependencies and local package manager caches
node_modules/
.npm/

# Playwright generated outputs
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Regenerable temporary artifacts only.
# Keep committed evidence under artifacts/eval/*.json, artifacts/eval/*.csv,
# artifacts/eval/*.html, and artifacts/traces/*.json/jsonl unless the README
# says a specific artifact can be regenerated.
artifacts/tmp/
artifacts/**/tmp/
artifacts/**/*.zip
artifacts/**/*.har
artifacts/**/*.webm
artifacts/**/*.mp4
artifacts/**/*.png
artifacts/**/*.jpg
artifacts/**/*.jpeg
!artifacts/demo/
!artifacts/demo/*.png

# Local editor/OS noise
.DS_Store
Thumbs.db
*.log
